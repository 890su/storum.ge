---
import BaseLayout from "../layouts/BaseLayout.astro";
import PalletCalculator from "./PalletCalculator.astro";
import LeadForm from "./LeadForm.astro";
import { content } from "../content/site";
import { localePaths, type Locale } from "../lib/locales";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const menuLabel = { ka: "მენიუ", en: "Menu", ru: "Меню" }[locale];
const navigationLabel = { ka: "ძირითადი ნავიგაცია", en: "Main navigation", ru: "Основная навигация" }[locale];
const languageLabel = { ka: "ენა", en: "Language", ru: "Язык" }[locale];
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={localePaths[locale]} aria-label="Storum home">
        <img class="brand-logo brand-logo-header" src="/assets/storum_logo-album.png" width="870" height="200" alt="Storum" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
        <span class="sr-only">{menuLabel}</span>
      </button>

      <nav class="main-nav" id="main-nav" aria-label={navigationLabel}>
        <a href="#services">{t.nav.services}</a>
        <a href="#calculator">{t.nav.pricing}</a>
        <a href="#process">{t.nav.process}</a>
        <a href="#faq">{t.nav.faq}</a>
      </nav>

      <div class="header-actions">
        <div class="language-switcher" aria-label={languageLabel}>
          <a href="/" aria-current={locale === "ka" ? "page" : undefined}>KA</a>
          <a href="/en/" aria-current={locale === "en" ? "page" : undefined}>EN</a>
          <a href="/ru/" aria-current={locale === "ru" ? "page" : undefined}>RU</a>
        </div>
        <a class="button button-small" href="#lead">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <h1>{t.hero.title}</h1>
          <p class="hero-text">{t.hero.text}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#calculator">{t.hero.primaryCta}</a>
            <a class="text-link" href="#lead">{t.hero.secondaryCta}<span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="pallet-card" aria-label={t.hero.diagramLabel}>
          <div class="pallet-card-top">
            <span>{t.hero.diagramLabel}</span>
            <span>EUR / 01</span>
          </div>
          <div class="pallet-plan" aria-hidden="true">
            <span class="measure measure-x">1.2 m</span>
            <span class="measure measure-y">0.8 m</span>
            <div class="pallet-slat slat-1"></div>
            <div class="pallet-slat slat-2"></div>
            <div class="pallet-slat slat-3"></div>
            <div class="pallet-slat slat-4"></div>
            <div class="pallet-slat slat-5"></div>
          </div>
          <div class="pallet-price">
            <span class="price-number">0.86</span>
            <span class="price-unit">GEL<br />{t.hero.perDay}</span>
          </div>
          <p>{t.hero.standardPallet}</p>
        </div>
      </div>
    </section>

    <div class="proof-strip" aria-label="Service facts">
      <div class="container proof-grid">
        {t.proofs.map((proof, index) => (
          <div class="proof-item"><span>{String(index + 1).padStart(2, "0")}</span>{proof}</div>
        ))}
      </div>
    </div>

    <section class="section audience-section" id="audience">
      <div class="container split-heading">
        <div class="section-intro">
          <p class="eyebrow">{t.audience.eyebrow}</p>
          <h2>{t.audience.title}</h2>
        </div>
        <p class="section-lead">{t.audience.text}</p>
      </div>
      <div class="container audience-list">
        {t.audience.items.map((item, index) => (
          <article class="audience-item">
            <span class="item-code">A{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section services-section" id="services">
      <div class="container">
        <div class="split-heading">
          <div class="section-intro">
            <p class="eyebrow">{t.services.eyebrow}</p>
            <h2>{t.services.title}</h2>
          </div>
          <p class="section-lead">{t.services.text}</p>
        </div>
        <div class="service-table" role="list">
          {t.services.items.map((service) => (
            <article class="service-row" role="listitem">
              <div>
                <h3>{service.name}</h3>
                <p>{service.detail}</p>
              </div>
              <strong>{service.price}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <PalletCalculator content={t.calculator} locale={locale} />

    <section class="section process-section" id="process">
      <div class="container">
        <div class="section-intro process-heading">
          <p class="eyebrow">{t.process.eyebrow}</p>
          <h2>{t.process.title}</h2>
        </div>
        <div class="process-grid">
          {t.process.items.map((item, index) => (
            <article class="process-step">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="private-section">
      <div class="container private-card">
        <p class="eyebrow">{t.privateClients.label}</p>
        <div>
          <h2>{t.privateClients.title}</h2>
          <p>{t.privateClients.text}</p>
        </div>
        <a class="text-link" href="#lead">{t.privateClients.cta}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container faq-layout">
        <div class="section-intro faq-heading">
          <p class="eyebrow">{t.faq.eyebrow}</p>
          <h2>{t.faq.title}</h2>
        </div>
        <div class="faq-list">
          {t.faq.items.map((item) => (
            <details>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <LeadForm content={t.lead} locale={locale} />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div><a class="footer-logo-link" href={localePaths[locale]} aria-label="Storum home"><img class="brand-logo brand-logo-footer" src="/assets/storum_logo_dark.png" width="515" height="485" alt="Storum" loading="lazy" /></a></div>
      <p>{t.footer.text}</p>
      <div><strong>{t.footer.location}</strong><a href={locale === "ka" ? "/privacy/" : `/${locale}/privacy/`}>{t.footer.privacy}</a></div>
      <small>© {new Date().getFullYear()} Storum</small>
    </div>
  </footer>

  <a class="mobile-cta" href="#lead">{t.nav.cta}</a>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const nav = document.querySelector<HTMLElement>(".main-nav");
    const closeMenu = () => {
      toggle?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("is-open");
    };
    toggle?.addEventListener("click", () => {
      const nextOpen = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(nextOpen));
      nav?.classList.toggle("is-open", nextOpen);
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth > 960) closeMenu();
    });
  </script>
</BaseLayout>
