---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePaths, type Locale } from "../lib/locales";

interface Props { locale: Locale }
const { locale } = Astro.props;

const copy = {
  ka: {
    title: "კონფიდენციალურობა | Storum",
    description: "როგორ ვიყენებთ განაცხადში მითითებულ მონაცემებს.",
    heading: "კონფიდენციალურობის პირობები",
    updated: "განახლებულია: 4 აგვისტო, 2026",
    intro: "Storum იყენებს ფორმაში მითითებულ მონაცემებს მხოლოდ თქვენს მოთხოვნაზე პასუხისა და შენახვის პირობების გაანგარიშებისთვის.",
    items: [
      ["რას ვაგროვებთ", "სახელს, საკონტაქტო მონაცემს, კომპანიისა და ტვირთის ინფორმაციას, თუ თავად მიუთითებთ."],
      ["როგორ ვიყენებთ", "მონაცემები გადაეცემა Storum-ის პასუხისმგებელ თანამშრომელს Telegram-ის დახურულ ჩატში, რათა დაგიკავშირდეთ."],
      ["რას არ ვაკეთებთ", "არ ვყიდით მონაცემებს და არ ვიყენებთ მათ მესამე მხარის რეკლამისთვის."],
      ["თქვენი მოთხოვნა", "მონაცემის წაშლის ან დაზუსტების მოთხოვნა შეგიძლიათ გამოგზავნოთ საიტის ფორმით."],
    ],
    back: "მთავარ გვერდზე დაბრუნება",
  },
  en: {
    title: "Privacy | Storum",
    description: "How Storum uses information submitted through the enquiry form.",
    heading: "Privacy notice",
    updated: "Updated: 4 August 2026",
    intro: "Storum uses the information submitted through the form only to answer your request and calculate suitable storage terms.",
    items: [
      ["What we collect", "Your name, contact details and any company or cargo information that you choose to provide."],
      ["How we use it", "The request is sent to the responsible Storum team member through a private Telegram chat so they can contact you."],
      ["What we do not do", "We do not sell your information or use it for third-party advertising."],
      ["Your request", "You can request correction or deletion of submitted information through the website form."],
    ],
    back: "Return to the main page",
  },
  ru: {
    title: "Конфиденциальность | Storum",
    description: "Как Storum использует информацию из формы заявки.",
    heading: "Условия конфиденциальности",
    updated: "Обновлено: 4 августа 2026 г.",
    intro: "Storum использует информацию из формы только для ответа на запрос и расчета подходящих условий хранения.",
    items: [
      ["Что мы собираем", "Имя, контакт и сведения о компании или грузе, которые вы решили сообщить."],
      ["Как используем", "Заявка передается ответственному сотруднику Storum через закрытый Telegram-чат, чтобы связаться с вами."],
      ["Чего мы не делаем", "Мы не продаем информацию и не используем ее для сторонней рекламы."],
      ["Ваш запрос", "Запросить исправление или удаление отправленной информации можно через форму сайта."],
    ],
    back: "Вернуться на главную",
  },
}[locale];
---

<BaseLayout locale={locale} title={copy.title} description={copy.description}>
  <main id="main" class="legal-page">
    <div class="container legal-inner">
      <a class="brand" href={localePaths[locale]}><span class="brand-mark">S</span><span>STORUM</span></a>
      <p class="eyebrow">{copy.updated}</p>
      <h1>{copy.heading}</h1>
      <p class="legal-intro">{copy.intro}</p>
      <div class="legal-list">
        {copy.items.map(([title, text]) => (
          <section><h2>{title}</h2><p>{text}</p></section>
        ))}
      </div>
      <a class="button button-primary" href={localePaths[locale]}>{copy.back}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .legal-page { min-height: 100vh; padding-block: clamp(2rem, 6vw, 5rem); background: var(--white); }
  .legal-inner { max-width: 820px; }
  .legal-inner > .brand { margin-bottom: clamp(4rem, 10vw, 8rem); }
  .legal-inner h1 { max-width: 12ch; font-size: clamp(2.8rem, 8vw, 5.5rem); }
  .legal-intro { max-width: 60ch; margin-bottom: 3rem; color: var(--ink-soft); font-size: 1.15rem; }
  .legal-list { margin-bottom: 3rem; border-top: 1px solid var(--ink); }
  .legal-list section { display: grid; grid-template-columns: 0.45fr 1fr; gap: 2rem; padding-block: 1.5rem; border-bottom: 1px solid var(--line); }
  .legal-list h2 { margin: 0; font-size: 1.35rem; }
  .legal-list p { color: var(--muted); }
  @media (max-width: 640px) { .legal-list section { grid-template-columns: 1fr; gap: 0.5rem; } }
</style>
