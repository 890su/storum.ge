---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "./LeadForm.astro";
import { content } from "../content/site";
import { ticketCopy, ticketPaths } from "../content/ticket";
import { locales, type Locale } from "../lib/locales";
import { calculateStorage, defaultCalculation, formatGel, prices } from "../lib/pricing";
import "../styles/ticket.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const site = content[locale];
const copy = ticketCopy[locale];
const initial = defaultCalculation;
const total = calculateStorage(initial);
const gel = (amount: number) => `${formatGel(amount, locale)} GEL`;
const distinctLinks = [
  { href: "#services", label: site.nav.pricing },
  { href: "#process", label: site.nav.process },
  { href: "#faq", label: site.nav.faq },
];
const privacyPath = locale === "ka" ? "/privacy/" : `/${locale}/privacy/`;
const lead = {
  estimate: total, pallets: initial.pallets, payload: JSON.stringify(initial), label: copy.quoteSummary,
  summary: `${site.calculator.pallets}: ${initial.pallets} · ${site.calculator.days}: ${initial.days} · ${gel(total)}`,
  edit: copy.edit, more: copy.more, invalid: copy.invalid,
};
---

<BaseLayout locale={locale} title={site.meta.title} description={site.meta.description} indexable={false} pageClass="ticket-page" skipLabel={copy.skip}>
  <header class="ticket-header">
    <div class="ticket-shell ticket-header-inner">
      <a class="ticket-brand" href={ticketPaths[locale]}><img src="/assets/storum_logo-album.png" alt="Storum" width="870" height="200" /></a>
      <nav class="ticket-nav" aria-label={copy.navigation}>
        {distinctLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <nav class="ticket-languages" aria-label={copy.languages}>
        {locales.map((code) => (
          <a href={ticketPaths[code]} lang={code} hreflang={code} aria-label={content[code].localeName} aria-current={code === locale ? "page" : undefined}>
            {code.toUpperCase()}
          </a>
        ))}
      </nav>
      <details class="ticket-mobile-nav" data-ticket-menu>
        <summary aria-label={copy.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </summary>
        <nav aria-label={copy.navigation}>
          {distinctLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
          <a href="#calculator">{site.hero.primaryCta}</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="ticket-dock" aria-labelledby="ticket-title">
      <article class="ticket-shell ticket-paper">
        <div class="ticket-intro">
          <div>
            <h1 id="ticket-title">{copy.title}</h1>
            <p class="ticket-rate"><strong>{gel(prices.storagePerDay)}</strong> <span>{copy.rateUnit}</span></p>
            <p class="ticket-offer">{site.hero.text}</p>
          </div>
          <div class="ticket-stamp" aria-hidden="true">
            <strong>STORUM</strong>
            <span>{site.footer.location}</span>
            <span>{copy.ticket}</span>
          </div>
        </div>

        <form class="ticket-calculator" id="calculator" action="#lead" aria-labelledby="estimate-title"
          data-ticket-calculator data-locale={locale} data-invalid={copy.invalid}>
          <h2 class="sr-only" id="estimate-title">{copy.ticket}</h2>
          <figure class="ticket-diagram">
            <figcaption>
              <strong>{copy.diagram}</strong>
              <span>{copy.illustrative}</span>
            </figcaption>
            <div class="ticket-slots" aria-hidden="true">
              {Array.from({ length: 18 }, (_, index) => (
                <div class:list={["ticket-slot", { "ticket-slot-active": index === 8 }]}>
                  {index === 8 ? <b>{formatGel(prices.storagePerDay, locale)}</b> :
                    <svg viewBox="0 0 28 21" fill="none" stroke="currentColor" stroke-width="1.2">
                      <rect x="3" y="2.5" width="22" height="11" rx="1" />
                      <path d="M2 14h24v3H2zM5 17v2m9-2v2m9-2v2" />
                    </svg>}
                </div>
              ))}
            </div>
            <p>{site.hero.standardPallet}</p>
          </figure>

          <fieldset class="ticket-volume">
            <legend>{copy.volume}</legend>
            <div class="ticket-volume-fields">
            <label class="ticket-field">
              <span>{site.calculator.pallets}</span>
              <input name="pallets" type="number" inputmode="numeric" min="1" max="999" required value={initial.pallets} />
            </label>
            <label class="ticket-field">
              <span>{site.calculator.days}</span>
              <input name="days" type="number" inputmode="numeric" min="1" max="365" required value={initial.days} />
            </label>
            </div>
          </fieldset>

          <fieldset class="ticket-handling">
            <legend>{copy.handling}</legend>
            <div class="ticket-checks">
            <label class="ticket-check"><input name="inbound" type="checkbox" checked={initial.inbound} /><span>{site.calculator.inbound}</span></label>
            <label class="ticket-check"><input name="outbound" type="checkbox" checked={initial.outbound} /><span>{site.calculator.outbound}</span></label>
            </div>
            <p class="ticket-unit">{gel(prices.mechanicalHandling)} · {copy.perPallet}</p>
            <details class="ticket-extra">
              <summary>{copy.extras}</summary>
              <label class="ticket-field">
                <span>{site.calculator.stretch}</span>
                <input name="stretchPallets" type="number" inputmode="numeric" min="0" max={initial.pallets} value={initial.stretchPallets} />
              </label>
              <label class="ticket-field">
                <span>{site.calculator.boxes}</span>
                <input name="boxes" type="number" inputmode="numeric" min="0" max="99999" value={initial.boxes} />
              </label>
            </details>
          </fieldset>

          <div class="ticket-result">
            <dl class="ticket-breakdown">
              <div><dt>{copy.storage}</dt><dd data-storage-cost>{gel(initial.pallets * initial.days * prices.storagePerDay)}</dd></div>
              <div><dt>{copy.handling}</dt><dd data-handling-cost>{gel(total - initial.pallets * initial.days * prices.storagePerDay)}</dd></div>
            </dl>
            <div class="ticket-total">
              <span>{site.calculator.result}</span>
              <output name="total">{gel(total)}</output>
            </div>
            <div class="ticket-next">
              <button type="submit" class="ticket-button">{copy.exactQuote}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12h17m-7-7 7 7-7 7" /></svg></button>
              <a href="#services">{copy.terms}</a>
            </div>
          </div>
        </form>
        <p class="ticket-note">{site.calculator.note}</p>
      </article>
      <ul class="ticket-shell ticket-proofs">
        {site.proofs.map((proof) => <li>{proof}</li>)}
      </ul>
    </section>

    <div class="ticket-content">
      <section class="ticket-shell ticket-section ticket-split" id="services" aria-labelledby="ticket-services-title">
        <div>
          <h2 id="ticket-services-title">{site.services.eyebrow}</h2>
          <p>{site.services.text}</p>
        </div>
        <dl class="ticket-rate-list">
          {site.services.items.map(({ name, detail, price }) => (
            <div><dt><strong>{name}</strong><span>{detail}</span></dt><dd>{price}</dd></div>
          ))}
        </dl>
      </section>

      <section class="ticket-shell ticket-section ticket-split" aria-labelledby="ticket-audience-title">
        <div><h2 id="ticket-audience-title">{site.audience.eyebrow}</h2><p>{site.audience.text}</p></div>
        <ul class="ticket-audience">
          {site.audience.items.map(({ title, text }) => <li><h3>{title}</h3><p>{text}</p></li>)}
        </ul>
      </section>

      <section class="ticket-process" id="process" aria-labelledby="ticket-process-title">
        <div class="ticket-shell ticket-section">
          <h2 id="ticket-process-title">{site.process.title}</h2>
          <ol>
            {site.process.items.map(({ title, text }, index) => <li><span aria-hidden="true">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>)}
          </ol>
        </div>
      </section>

      <section class="ticket-shell ticket-section ticket-split" id="faq" aria-labelledby="ticket-faq-title">
        <div><h2 id="ticket-faq-title">{site.faq.eyebrow}</h2></div>
        <div class="ticket-faq">
          {site.faq.items.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
        </div>
      </section>

      <aside class="ticket-shell ticket-private">
        <div><h2>{site.privateClients.label}</h2><p>{site.privateClients.text}</p></div>
        <a href="#lead">{site.privateClients.cta}</a>
      </aside>
    </div>

    <LeadForm content={{ ...site.lead, title: copy.exactQuote }} locale={locale} quote={lead} />
  </main>

  <footer class="ticket-footer">
    <div class="ticket-shell">
      <a href={ticketPaths[locale]}><img src="/assets/storum_logo_dark.png" alt="Storum" width="515" height="485" loading="lazy" /></a>
      <p>{site.footer.text}<br />{site.footer.location}</p>
      <a href={privacyPath}>{site.footer.privacy}</a>
    </div>
  </footer>
</BaseLayout>

<script>
  import { calculateStorage, formatGel, prices } from "../lib/pricing";

  const form = document.querySelector<HTMLFormElement>("[data-ticket-calculator]");
  if (form) {
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const output = form.elements.namedItem("total") as HTMLOutputElement;
    const quoteField = document.querySelector<HTMLInputElement>("[data-lead-quote]");
    const estimateField = document.querySelector<HTMLInputElement>("#lead-estimate");
    const palletsField = document.querySelector<HTMLInputElement>("#lead-pallets");
    const summary = document.querySelector<HTMLElement>("[data-lead-summary]");
    const storageCost = form.querySelector<HTMLElement>("[data-storage-cost]");
    const handlingCost = form.querySelector<HTMLElement>("[data-handling-cost]");
    const gel = (amount: number) => `${formatGel(amount, form.dataset.locale ?? "ka")} GEL`;
    const label = (name: string) => input(name).labels?.[0]?.querySelector("span")?.textContent ?? "";
    const summaryLabels = { pallets: label("pallets"), days: label("days") };

    const update = () => {
      const pallets = input("pallets");
      const stretch = input("stretchPallets");
      stretch.max = pallets.validity.valid ? pallets.value : "999";
      if (Array.from(form.querySelectorAll("input")).some((field) => !field.validity.valid)) {
        output.value = "—";
        if (quoteField) quoteField.value = "";
        if (summary) summary.textContent = form.dataset.invalid ?? "";
        if (storageCost) storageCost.textContent = "—";
        if (handlingCost) handlingCost.textContent = "—";
        return;
      }
      const quote = {
        pallets: pallets.valueAsNumber,
        days: input("days").valueAsNumber,
        inbound: input("inbound").checked,
        outbound: input("outbound").checked,
        stretchPallets: stretch.valueAsNumber || 0,
        boxes: input("boxes").valueAsNumber || 0,
      };
      const storage = quote.pallets * quote.days * prices.storagePerDay;
      const estimate = calculateStorage(quote);
      output.value = gel(estimate);
      if (storageCost) storageCost.textContent = gel(storage);
      if (handlingCost) handlingCost.textContent = gel(estimate - storage);
      if (quoteField) quoteField.value = JSON.stringify(quote);
      if (estimateField) estimateField.value = estimate.toFixed(2);
      if (palletsField) palletsField.value = String(quote.pallets);
      if (summary) summary.textContent = `${summaryLabels.pallets}: ${quote.pallets} · ${summaryLabels.days}: ${quote.days} · ${gel(estimate)}`;
    };

    form.addEventListener("input", update);
    form.addEventListener("invalid", (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement) {
        const details = field.closest("details");
        if (details) details.open = true;
      }
    }, true);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      update();
      window.location.hash = "lead";
      document.getElementById("lead")?.focus({ preventScroll: true });
    });
    update();
  }

  const menu = document.querySelector<HTMLDetailsElement>("[data-ticket-menu]");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
  });
  menu?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu.open) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
  });
</script>
