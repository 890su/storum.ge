---
import BaseLayout from "../layouts/BaseLayout.astro";
import PalletCalculator from "./PalletCalculator.astro";
import LeadForm from "./LeadForm.astro";
import { content } from "../content/site";

const t = content.ru;
---

<BaseLayout locale="ru" title={`Концепт One Pallet — ${t.meta.title}`} description={t.meta.description} indexable={false} pageClass="concept-preview">
  <div class="one-shell">
    <div class="one-switch" aria-label="Варианты дизайна"><span>ВАРИАНТ</span><a href="/ru/">1</a><a href="/ru/design-2/">2</a><a href="/ru/design-3/" aria-current="page">3</a></div>

    <header class="one-header">
      <a class="one-brand one-brand-header" href="/ru/" aria-label="Storum"><img src="/assets/storum_logo-album.png" width="870" height="200" alt="Storum" /></a>
      <button class="one-menu" type="button" aria-expanded="false" aria-controls="one-nav">
        <span></span><span></span><span></span><b>Меню</b>
      </button>
      <nav class="one-nav" id="one-nav" aria-label="Навигация"><a href="#one-use">Для кого</a><a href="#one-services">Услуги</a><a href="#calculator">Калькулятор</a></nav>
      <div class="one-head-actions"><span class="one-langs" aria-label="Язык"><a href="/">KA</a><a href="/en/">EN</a><a href="/ru/" aria-current="page">RU</a></span><a class="one-btn one-btn-dark one-header-cta" href="#lead">Получить расчёт</a></div>
    </header>

    <main id="main">
      <section class="one-hero">
        <div class="one-copy">
          <p class="one-label">ПАЛЛЕТНОЕ ХРАНЕНИЕ В БАТУМИ</p>
          <h1>Склад,<br />который начинается<br /><em>с одной паллеты.</em></h1>
          <p class="one-intro">Не арендуйте пустые метры. Храните ровно тот объём, который нужен бизнесу сегодня.</p>
          <div class="one-actions"><a class="one-btn one-btn-dark" href="#calculator">Посчитать стоимость</a><a class="one-plain" href="#lead">Записаться на осмотр <span>↗</span></a></div>
          <div class="one-trust">{t.proofs.slice(0,3).map((proof) => <span><i>●</i>{proof}</span>)}</div>
        </div>

        <div class="space-card" aria-label="Стоимость одного паллето-места">
          <div class="space-card-head"><span>ВАШЕ МЕСТО</span><span>BATUMI · SLOT 01</span></div>
          <div class="slot-grid" aria-hidden="true">
            {Array.from({length:24}).map((_, index) => <i class={index === 14 ? "active" : ""}>{index === 14 ? <b>01</b> : ""}</i>)}
          </div>
          <div class="space-price"><div><strong>0,86</strong><small>GEL / сутки</small></div><span>европаллета<br />0,8 × 1,2 м<br />до 1,4 м</span></div>
          <a href="#calculator">Рассчитать несколько паллет <span>→</span></a>
        </div>
      </section>

      <section class="one-use" id="one-use">
        <div class="one-title"><p class="one-label">КОМУ ЭТО ВЫГОДНО</p><h2>Товару — место.<br />Бизнесу — свобода.</h2></div>
        <div class="use-cards">
          {t.audience.items.map((item,index) => (
            <article><span class="use-icon" aria-hidden="true">{index === 0 ? "↘" : index === 1 ? "□" : index === 2 ? "◇" : "○"}</span><small>0{index+1}</small><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </section>

      <section class="one-services" id="one-services">
        <div class="one-title"><p class="one-label">ПРОЗРАЧНЫЕ ТАРИФЫ</p><h2>Платите за хранение.<br />Добавляйте только нужное.</h2></div>
        <div class="service-board">
          {t.services.items.map((service,index) => (
            <article class={index === 0 ? "primary" : ""}><span>{index === 0 ? "ОСНОВА" : `+ 0${index}`}</span><div><h3>{service.name}</h3><p>{service.detail}</p></div><strong>{service.price}</strong></article>
          ))}
        </div>
      </section>

      <div class="one-calculator"><PalletCalculator content={t.calculator} locale="ru" /></div>

      <section class="one-process">
        <div class="one-title"><p class="one-label">БЕЗ СЛОЖНОЙ ЛОГИСТИКИ</p><h2>Путь вашей партии</h2></div>
        <div class="journey">
          {t.process.items.map((item,index) => (
            <article><div><span>{index+1}</span><i></i></div><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </section>

      <section class="one-private">
        <div class="private-shape" aria-hidden="true"><span></span><span></span><span></span></div>
        <div><p class="one-label">{t.privateClients.label}</p><h2>{t.privateClients.title}</h2><p>{t.privateClients.text}</p><a class="one-btn one-btn-dark" href="#lead">{t.privateClients.cta}</a></div>
      </section>

      <section class="one-faq">
        <div class="one-title"><p class="one-label">КОРОТКО О ГЛАВНОМ</p><h2>{t.faq.title}</h2></div>
        <div class="one-faq-list">{t.faq.items.map((item,index) => <details><summary><span>0{index+1}</span>{item.question}<b>+</b></summary><p>{item.answer}</p></details>)}</div>
      </section>

      <div class="one-lead"><LeadForm content={t.lead} locale="ru" /></div>
    </main>

    <footer class="one-footer"><a class="one-footer-logo" href="/ru/" aria-label="Storum"><img src="/assets/storum_logo_dark.png" width="515" height="485" alt="Storum" loading="lazy" /></a><p>Паллетное хранение и складские услуги<br />Батуми, Грузия</p><a href="/ru/privacy/">Конфиденциальность</a></footer>
  </div>

  <script>
    const menu = document.querySelector<HTMLButtonElement>(".one-menu");
    const nav = document.querySelector<HTMLElement>(".one-nav");
    const closeMenu = () => {
      menu?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("is-open");
    };

    menu?.addEventListener("click", () => {
      const nextOpen = menu.getAttribute("aria-expanded") !== "true";
      menu.setAttribute("aria-expanded", String(nextOpen));
      nav?.classList.toggle("is-open", nextOpen);
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1000) closeMenu();
    });
  </script>
</BaseLayout>

<style>
  :global(html),:global(body){margin:0;overflow-x:clip}
  .one-shell{--ink:#122b27;--green:#1f5a4e;--mint:#d9ebe5;--ice:#f3f7f5;--lime:#d8f05b;--yellow:#ffcf4a;--line:#8ea59e;--font-display:var(--body);--font-body:var(--body);--font-data:Consolas,"Liberation Mono",monospace;min-height:100vh;overflow-x:clip;background:var(--ice);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.55}
  :global(.one-shell h1),:global(.one-shell h2),:global(.one-shell h3){font-family:var(--font-display);font-weight:780;text-wrap:balance}
  .one-switch{position:fixed;z-index:30;right:16px;bottom:16px;display:flex;align-items:center;gap:5px;padding:6px;background:#fff;border-radius:99px;box-shadow:0 12px 40px #18372f33}
  .one-switch>span{padding:0 8px;font:700 9px/1 monospace;letter-spacing:.1em;color:#637b74}.one-switch a{display:grid;width:32px;height:32px;place-items:center;border-radius:50%;color:var(--ink);font:800 11px/1 monospace;text-decoration:none}.one-switch a[aria-current="page"]{background:var(--ink);color:#fff}
  .one-header{position:sticky;z-index:100;top:0;height:84px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:35px;padding:0 clamp(20px,5vw,76px);border-bottom:1px solid #b5c7c1;background:rgba(243,247,245,.94);box-shadow:0 8px 28px rgba(18,43,39,.08);backdrop-filter:blur(14px)}
  .one-brand{display:flex;align-items:center;color:var(--ink);text-decoration:none}.one-brand-header img{display:block;width:174px;height:auto}
  .one-nav{display:flex;justify-content:center;gap:clamp(24px,2.5vw,42px)}.one-nav a{display:inline-flex;min-height:44px;align-items:center;color:var(--ink);font-size:15px;font-weight:750;line-height:1.2;text-decoration:none}.one-nav a:hover{color:var(--green)}
  .one-head-actions{display:flex;align-items:center;gap:18px}.one-langs{display:flex;align-items:center;gap:4px}.one-langs a{display:grid;width:38px;height:38px;place-items:center;border-radius:10px;color:#425f57;font:800 12px/1 var(--font-data);text-decoration:none}.one-langs a:hover{background:#e2eeea;color:var(--ink)}.one-langs a[aria-current="page"]{background:var(--ink);color:#fff}
  .one-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 22px;border-radius:14px;color:var(--ink);font-size:14px;font-weight:800;line-height:1.2;text-align:center;text-decoration:none}.one-btn-dark{background:var(--ink);color:#fff;box-shadow:0 6px 0 #091c19}.one-btn-dark:hover{transform:translateY(2px);box-shadow:0 4px 0 #091c19}
  .one-menu{display:none;width:46px;height:46px;padding:7px;border:0;border-radius:12px;background:transparent;color:var(--ink);cursor:pointer}.one-menu>span{display:block;width:24px;height:2px;margin:4px auto;background:currentColor;transition:transform .18s,opacity .18s}.one-menu b{display:block;margin-top:4px;font-size:9px;line-height:1}.one-menu[aria-expanded="true"]>span:nth-child(1){transform:translateY(6px) rotate(45deg)}.one-menu[aria-expanded="true"]>span:nth-child(2){opacity:0}.one-menu[aria-expanded="true"]>span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
  .one-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(410px,.9fr);gap:clamp(35px,6vw,90px);align-items:center;min-height:750px;padding:75px clamp(20px,7vw,110px) 90px;background:radial-gradient(circle at 80% 25%,#d5ece4 0 12%,transparent 12.3%),radial-gradient(circle at 84% 25%,#e5f2ee 0 25%,transparent 25.3%),var(--ice)}
  .one-label{margin:0 0 25px;color:var(--green);font:800 11px/1.35 var(--font-data);letter-spacing:.13em}
  .one-copy h1{max-width:10.5ch;margin:0;font-size:clamp(54px,5.7vw,88px);line-height:.94;letter-spacing:-.06em}.one-copy h1 em{position:relative;display:block;color:var(--green);font-style:normal;white-space:normal}.one-copy h1 em::after{content:"";position:absolute;z-index:-1;left:-2%;right:-2%;bottom:4%;height:22%;border-radius:50%;background:var(--lime);transform:rotate(-1deg)}
  .one-intro{max-width:630px;margin:34px 0 0;color:#526a63;font-size:clamp(18px,1.6vw,23px);line-height:1.45}.one-actions{display:flex;align-items:center;gap:28px;margin-top:35px}.one-plain{color:var(--ink);font-size:13px;font-weight:800;text-decoration:none}.one-plain span{margin-left:8px;color:var(--green)}
  .one-trust{display:flex;flex-wrap:wrap;gap:17px 26px;margin-top:46px}.one-trust span{color:#4e675f;font-size:12px;font-weight:700}.one-trust i{margin-right:8px;color:var(--green);font-size:7px;font-style:normal}
  .space-card{position:relative;padding:25px;border:1px solid #9bb1aa;border-radius:28px 28px 5px 28px;background:#fff;box-shadow:14px 14px 0 var(--yellow)}.space-card::after{content:"";position:absolute;top:-13px;right:55px;width:60px;height:26px;border-radius:50%;background:var(--lime);transform:rotate(-6deg)}
  .space-card-head{display:flex;justify-content:space-between;padding-bottom:20px;border-bottom:1px solid #a9bdb7;color:#49635b;font:700 10px/1 var(--font-data);letter-spacing:.1em}
  .slot-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin:37px 0}.slot-grid i{position:relative;aspect-ratio:1;border:1px solid #aec0ba;border-radius:5px;background:#edf4f1}.slot-grid i.active{display:grid;place-items:center;border-color:var(--ink);background:var(--lime);box-shadow:0 0 0 4px #d8f05b55}.slot-grid b{font:900 12px/1 monospace}
  .space-price{display:flex;align-items:flex-end;justify-content:space-between;padding-top:22px;border-top:1px solid #a9bdb7}.space-price>div{display:flex;align-items:flex-end;gap:11px}.space-price strong{font-size:clamp(58px,6vw,88px);line-height:.8;letter-spacing:-.07em}.space-price small{padding-bottom:3px;color:var(--green);font-weight:800}.space-price>span{color:#4f675f;font:700 10px/1.55 var(--font-data);text-align:right;text-transform:uppercase}.space-card>a{display:flex;justify-content:space-between;margin-top:28px;padding:18px 0 0;border-top:1px solid #a9bdb7;color:var(--ink);font-size:14px;font-weight:800;text-decoration:none}
  .one-use,.one-services,.one-process,.one-faq{padding:110px clamp(20px,7vw,110px)}.one-title{display:grid;grid-template-columns:.7fr 1.3fr;align-items:start;margin-bottom:55px}.one-title h2{margin:0;font-size:clamp(43px,5.2vw,78px);line-height:.95;letter-spacing:-.06em}
  .one-use{background:var(--mint)}.use-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:stretch}.use-cards article{position:relative;display:flex;min-height:320px;flex-direction:column;padding:24px;border-radius:22px 22px 4px 22px;background:#fff}.use-icon{display:grid;width:47px;height:47px;place-items:center;border-radius:14px;background:var(--ink);color:var(--lime);font-size:25px}.use-cards small{position:absolute;top:25px;right:25px;color:#526a63;font:800 11px/1 var(--font-data)}.use-cards h3{margin:66px 0 14px;font-size:22px;line-height:1.12;letter-spacing:-.025em}.use-cards p{margin-top:auto;color:#4f675f;font-size:14px;line-height:1.6}
  .one-services{background:var(--ice)}.service-board{border-top:1px solid var(--line)}.service-board article{display:grid;grid-template-columns:90px 1fr auto;gap:24px;align-items:center;min-height:100px;border-bottom:1px solid var(--line)}.service-board article>span{font:800 11px/1 var(--font-data);color:#526a63}.service-board h3{margin:0;font-size:20px;line-height:1.2}.service-board p{margin:6px 0 0;color:#536a63;font-size:13px;line-height:1.45}.service-board strong{font-size:17px;white-space:nowrap}.service-board article.primary{margin-bottom:8px;padding:0 18px;border:0;border-radius:18px;background:var(--ink);color:#fff}.service-board article.primary>span,.service-board article.primary p{color:#c6d9d3}.service-board article.primary strong{color:var(--lime)}
  .one-process{background:#fff}.journey{display:grid;grid-template-columns:repeat(4,1fr);gap:0}.journey article{min-width:0;padding-right:24px}.journey article>div{display:flex;align-items:center}.journey article span{display:grid;flex:0 0 42px;height:42px;place-items:center;border:1px solid var(--ink);border-radius:50%;font:800 11px/1 var(--font-data)}.journey article i{width:100%;border-top:1px dashed #7f9991}.journey article:last-child i{display:none}.journey h3{margin:26px 0 10px;font-size:20px;line-height:1.2}.journey p{color:#536a63;font-size:15px;line-height:1.55}
  .one-private{display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:9vw;padding:90px clamp(20px,9vw,140px);background:var(--yellow)}.one-private h2{margin:0;font-size:clamp(40px,5vw,72px);line-height:.95;letter-spacing:-.06em}.one-private>div:last-child>p:not(.one-label){max-width:640px;color:#4d5e54;font-size:16px;line-height:1.55}.one-private .one-btn{margin-top:18px}.private-shape{position:relative;display:grid;grid-template-columns:repeat(3,1fr);align-items:end;height:340px;padding:25px;border:2px solid var(--ink);border-radius:50% 50% 8px 8px;background:#ffe29a;overflow:hidden}.private-shape span{height:60%;border:2px solid var(--ink);background:repeating-linear-gradient(90deg,var(--mint) 0 12px,#a9cec1 12px 17px)}.private-shape span:nth-child(2){height:88%;background:repeating-linear-gradient(90deg,var(--lime) 0 12px,#b5cb45 12px 17px)}.private-shape span:nth-child(3){height:45%}
  .one-faq{background:var(--ice)}.one-faq-list{border-top:1px solid var(--line)}.one-faq-list details{border-bottom:1px solid var(--line)}.one-faq-list summary{display:grid;grid-template-columns:50px 1fr auto;gap:20px;padding:24px 0;cursor:pointer;list-style:none;font-weight:800}.one-faq-list summary>span{color:var(--green);font:800 10px/1.7 monospace}.one-faq-list summary b{color:var(--green);font-size:20px}.one-faq-list p{max-width:780px;margin:0 0 25px 70px;color:#597069;line-height:1.6}
  .one-footer{display:flex;align-items:center;justify-content:space-between;padding:38px clamp(20px,7vw,110px) 80px;background:var(--ink);color:#abc0ba}.one-footer-logo{display:grid;width:88px;place-items:center;text-decoration:none}.one-footer-logo img{display:block;width:100%;height:auto}.one-footer p{font-size:12px;line-height:1.5}.one-footer>a:last-child{color:#c8d8d3;font-size:12px}
  :global(.one-calculator .calculator-section){background:var(--green);color:#fff}.one-calculator :global(.calculator-layout){max-width:none;padding-left:clamp(20px,7vw,110px);padding-right:clamp(20px,7vw,110px)}.one-calculator :global(.calculator-copy>p:not(.eyebrow)){max-width:42ch;color:#e1eee9;font-size:17px;line-height:1.55}.one-calculator :global(.formula){color:#e1eee9}.one-calculator :global(.formula span){border-color:#82aa9f;color:#e1eee9}.one-calculator :global(.calculator){border:0;border-radius:26px 26px 5px 26px;background:#fff;color:var(--ink);box-shadow:15px 15px 0 var(--lime)}.one-calculator :global(.eyebrow){color:var(--lime)}.one-calculator :global(.calculator .field>span){color:#294b43;font-size:13px}.one-calculator :global(.check){border-color:#9eb3ad}.one-calculator :global(.calculator-result){align-items:center}.one-calculator :global(.calculator-result>span){max-width:13ch;line-height:1.3}.one-calculator :global(.calculator-result strong){display:flex;align-items:flex-end;gap:8px;white-space:nowrap;font-family:var(--font-display);font-size:clamp(48px,5vw,64px);line-height:.9}.one-calculator :global(.calculator-result small){padding-bottom:4px;color:var(--green);font-size:11px}.one-calculator :global(.calculator-note){color:#526a63;font-size:13px;line-height:1.5}.one-calculator :global(.button-dark){border-radius:13px;background:var(--ink)}
  :global(.one-lead .lead-section){background:var(--mint);color:var(--ink)}.one-lead :global(.lead-layout){max-width:none;padding-left:clamp(20px,7vw,110px);padding-right:clamp(20px,7vw,110px)}.one-lead :global(.lead-copy){color:var(--ink)}.one-lead :global(.eyebrow-light){color:var(--green)}.one-lead :global(.lead-copy>p:not(.eyebrow)){max-width:40ch;color:#345d54;font-size:17px;line-height:1.55}.one-lead :global(.lead-marker){border-color:#7ba69b;color:var(--green)}.one-lead :global(.lead-marker span){border-color:#7ba69b;color:#315d53;font-size:11px;font-weight:700}.one-lead :global(.lead-form){border:0;border-radius:26px 26px 5px 26px;background:#fff;color:var(--ink);box-shadow:14px 14px 0 var(--yellow)}.one-lead :global(.lead-form .field>span){color:#294b43;font-size:13px}.one-lead :global(.lead-form input),.one-lead :global(.lead-form textarea){border-radius:10px;border-color:#8fa9a2;background:var(--ice)}.one-lead :global(.consent){color:#526a63;font-size:13px;line-height:1.5}.one-lead :global(.consent a){color:#173f37;font-weight:700}.one-lead :global(.button-accent){border-radius:13px;background:var(--ink);color:#fff}
  @media(max-width:1000px){.one-header{grid-template-columns:auto auto 1fr;gap:16px}.one-menu{display:block}.one-nav{position:absolute;top:100%;right:0;left:0;display:none;padding:14px clamp(20px,5vw,76px) 22px;border-bottom:1px solid #b5c7c1;background:#f3f7f5;box-shadow:0 16px 30px rgba(18,43,39,.12)}.one-nav.is-open{display:grid}.one-nav a{min-height:52px;border-bottom:1px solid #cbd9d4;font-size:17px}.one-head-actions{justify-self:end}.one-hero{grid-template-columns:1fr}.space-card{max-width:680px}.use-cards{grid-template-columns:repeat(2,1fr)}.one-private{grid-template-columns:1fr}.private-shape{max-width:500px}.one-title{grid-template-columns:1fr;gap:12px}}
