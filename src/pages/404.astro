---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout locale="ka" title="გვერდი ვერ მოიძებნა | Storum" description="Page not found">
  <main id="main" class="not-found">
    <div>
      <p class="eyebrow">404 / STORUM</p>
      <h1>გვერდი ვერ მოიძებნა</h1>
      <a class="button button-primary" href="/">მთავარ გვერდზე დაბრუნება</a>
    </div>
  </main>
</BaseLayout>
<style>
  .not-found { min-height: 100vh; display: grid; place-items: center; padding: 2rem; background: var(--white); }
  .not-found > div { width: min(100%, 760px); }
</style>
